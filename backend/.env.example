# Copy to .env and fill in. Loaded automatically on server startup.

# Required: API key for your LLM provider.
OPENAI_API_KEY=sk-...

# Optional: override to point at any OpenAI-compatible endpoint
# (Azure OpenAI, OpenRouter, a local vLLM/Ollama server, a proxy, etc).
# Leave unset to use the default OpenAI API.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: model name understood by whichever provider is behind OPENAI_BASE_URL.
LLM_MODEL=gpt-4o-mini
